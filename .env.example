# Copy this to .env on the machine that actually runs the worker (your
# production server — never run this worker locally, it shares the same DB
# as the portal backend). Fill in real values, then `pm2 restart contribution-worker`.

# ── Required: same databases the backend uses ────────────────────────────────
# Copy these two verbatim from backend/.env on the backend server — they must
# point at the exact same MongoDB Atlas cluster/databases, since this worker
# writes ledgers the backend only reads.
MONGO_URI_QUANTUM=
MONGO_RANKING_URI=

# GitHub Personal Access Token (classic), scopes: repo + admin:org (or at
# least read:org, read:user). Reuse the same token already in backend/.env's
# GITHUB_TOKEN — one token, generated at
# https://github.com/settings/tokens -> Generate new token (classic).
# Without it, commit counts collapse to whatever the public events API still
# remembers (a few days).
GITHUB_TOKEN=

# ── Optional: sweep pacing (defaults shown are what the code falls back to) ──
# SWEEP_INTERVAL_HOURS=24
# RECENT_INTERVAL_MINUTES=2
# POLYCODE_INTERVAL_MINUTES=15
# POLYCODE_API_URL=https://poly-code-backend.vercel.app

# ── Achiever finalize trigger — OFF unless both are set ──────────────────────
# Without these, the worker never calls the backend to decide a day's winner,
# so award emails below never fire either (the portal's own Explore-page
# rebuild still freezes the award — it just won't email anyone).
#
# PORTAL_API_URL: the backend's own public origin (where your backend is
# actually deployed — e.g. your Vercel project URL or custom API domain).
# Find it in your Vercel project dashboard, or wherever backend/server.js is
# hosted. NOT the frontend URL.
PORTAL_API_URL=

# Must match what backend/routes/cron.js resolves: CRON_SECRET if set on the
# backend, otherwise it falls back to the backend's own JWT_SECRET. Copy
# whichever one the backend actually has from backend/.env — set both here
# and it'll work either way.
CRON_SECRET=
JWT_SECRET=

# How often to poll for the midnight cutover (minutes) and which PKT hour
# counts as "the day just closed" (0 = midnight). Defaults shown.
# ACHIEVERS_CHECK_MINUTES=10
# ACHIEVERS_FINALIZE_HOUR_PKT=0

# ── SMTP — sends the "you won" email once a window is decided ────────────────
# Namecheap Private Email (mail.privateemail.com) settings for
# admin@quantumlogicslimited.com. Find/reset the mailbox password at
# https://www.privateemail.com (or Namecheap dashboard -> Private Email ->
# Manage -> that mailbox). Without these set, the worker just logs the email
# instead of sending it — safe to leave blank while testing.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@quantumlogicslimited.com
SMTP_PASS=
SMTP_FROM=admin@quantumlogicslimited.com
